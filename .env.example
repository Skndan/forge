# ============================================================
# Forge — Environment Configuration
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_PASSWORD=forge_dev_password_change_me
POSTGRES_PORT=5432

# ── Keycloak ────────────────────────────────────────────────
KEYCLOAK_ADMIN_PASSWORD=admin_change_me
KEYCLOAK_PORT=8080
KEYCLOAK_ISSUER=http://localhost:8080/realms/forge
JWKS_URL=http://keycloak:8080/realms/forge/protocol/openid-connect/certs

# ── Gateway ─────────────────────────────────────────────────
GATEWAY_PORT=3000
GATEWAY_URL=http://localhost:3000
ADMIN_SERVICE_TOKEN=forge_admin_token_change_me
CORS_ORIGINS=*
RATE_LIMIT_MAX=100

# ── Realtime ────────────────────────────────────────────────
REALTIME_PORT=3001

# ── Function Runner ─────────────────────────────────────────
FUNCTION_RUNNER_PORT=3002
FN_JWT_SECRET=forge-fn-jwt-dev-secret
FN_DEFAULT_TIMEOUT_MS=30000
FN_MAX_TIMEOUT_MS=300000
FN_MAX_MEMORY_MB=512
FN_MAX_CPU_SHARES=512
FN_WARM_POOL_MAX_PER_TENANT=10
FN_WARM_POOL_REBALANCE_MS=30000
FN_WARM_POOL_IDLE_MS=300000
FN_LOG_RETENTION_DAYS=30

# ── Dashboard ───────────────────────────────────────────────
DASHBOARD_PORT=3003
KEYCLOAK_URL=http://localhost:8080

# ── RustFS (S3-compatible storage) ──────────────────────────
RUSTFS_ACCESS_KEY=forge_access_key
RUSTFS_SECRET_KEY=forge_secret_key_change_me
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_REGION=us-east-1

# ── Valkey ──────────────────────────────────────────────────
VALKEY_PORT=6379
VALKEY_URL=redis://valkey:6379
